# Cloud Integration Credential Encryption
# Auto-generated on first run if absent. Copy the generated value here to persist it.
INTEGRATION_SECRET_KEY=<auto-generated-44-char-fernet-key>

# GROQ API Configuration
GROQ_API_KEY=<your-api-key>

# GROQ API base URL must use the OpenAI-compatible endpoint.
# The legacy groq.ai endpoint is no longer valid.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model Routing
PRIMARY_MODEL=anthropic/claude-opus-4.1
SECONDARY_MODEL=anthropic/claude-sonnet-4
FAST_MODEL=google/gemini-2.5-flash
FALLBACK_MODEL=google/gemini-2.5-pro

# ---------------------------------------------------------------------------
# Telemetry data paths (configure via environment variables)
# ---------------------------------------------------------------------------

# Parquet telemetry files (metric_app, metric_container, log_service, etc.)
PARQUET_DIR=/path/to/your/parquet

# Individual incident JSON files
BANK_INCIDENTS_DIR=/path/to/your/incidents

# Individual alert JSON files
BANK_ALERTS_DIR=/path/to/your/alerts

# Optional: CSV incident index
INCIDENTS_CSV=/path/to/your/incidents.csv

# RCA evaluation: input queries and output results
QUERY_CSV=/path/to/your/query.csv
RCA_OUTPUT_CSV=/path/to/your/rca_results.csv

# ---------------------------------------------------------------------------
# MinIO metrics pipeline (obs-metrics bucket — metrics only)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_SECURE=false
MINIO_METRICS_BUCKET=obs-metrics
PROMETHEUS_QUERY_URL=http://127.0.0.1:9090
