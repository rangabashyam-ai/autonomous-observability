# Cloud Integration Credential Encryption
# Auto-generated on first run if absent. Copy the generated value here to persist it.
INTEGRATION_SECRET_KEY=<auto-generated-44-char-fernet-key>

# GROQ API Configuration
GROQ_API_KEY=<your-api-key>

# GROQ API base URL must use the OpenAI-compatible endpoint.
# The legacy groq.ai endpoint is no longer valid.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model Routing
PRIMARY_MODEL=anthropic/claude-opus-4.1
SECONDARY_MODEL=anthropic/claude-sonnet-4
FAST_MODEL=google/gemini-2.5-flash
FALLBACK_MODEL=google/gemini-2.5-pro

# ---------------------------------------------------------------------------
# Bank telemetry dataset paths
# All paths point to the openRCA_Bank directory (the moved Bank dataset).
# Override these to point to your own dataset location.
# ---------------------------------------------------------------------------

# Parquet telemetry files (metric_app, metric_container, log_service, etc.)
PARQUET_DIR=C:\path\to\openRCA_Bank\parquet

# Individual incident JSON files (all_incidents.json + incident_INC-*.json)
BANK_INCIDENTS_DIR=C:\path\to\openRCA_Bank\incidents

# Individual alert JSON files (alert_*.json, ~25k files)
BANK_ALERTS_DIR=C:\path\to\openRCA_Bank\alerts

# Optional: CSV incident index (enriches incident list view; code falls back
# to all_incidents.json if this file does not exist)
INCIDENTS_CSV=C:\path\to\openRCA_Bank\incidents.csv

# RCA evaluation: input queries and output results
QUERY_CSV=C:\path\to\openRCA_Bank\query.csv
RCA_OUTPUT_CSV=C:\path\to\openRCA_Bank\rca_results.csv
